<?xml version="1.0" encoding="UTF-8"?>
<!--
    This file only uses settings that exist from PHPUnit 9.6 to PHPUnit 13,
    so the same configuration runs without warnings on PHP 7.4 to 8.6.
    Stricter checks for PHPUnit 11+: run "composer test:strict".
-->
<phpunit bootstrap="vendor/autoload.php"
         colors="true"
         backupGlobals="false"
         processIsolation="false"
         stopOnFailure="false"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Tests">
            <directory suffix="Test.php">./tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
